# Audio
ro.vendor.audio.stereo_master_volume=1
vendor.audio.min.dr0=5.1
vendor.audio.max.dr0=6.9
vendor.audio.min.dr1=5.1
vendor.audio.max.dr1=6.9
vendor.audio.min.temp=20.0
vendor.audio.max.temp=60.0

# Camera
persist.vendor.camera.physical.num=3
persist.vendor.camera.privapp.list=com.motorola.camera5,com.android.DeviceAsWebcam
persist.vendor.camera.expose.aux=1
vendor.camera.aux.packagelist=org.codeaurora.snapcam,com.motorola.camera3,com.motorola.camera5,com.motorola.motocit
vendor.camera.aux.packagelist2=com.motorola.ccc,com.android.settings,com.motorola.handycam
ro.camera.enableCamera1MaxZsl=1
ro.camerax.extensions.enabled=true
ro.vendor.audio.camera_video_ainr.supported=true

# Display
ro.vendor.display.sensortype=2

# Sensors
persist.vendor.sensors.mot_tap=false
ro.vendor.sensors.glance_approach=false
ro.vendor.sensors.prox_for_call=false
ro.vendor.sensors.motorola.double_tap=true
ro.vendor.sensors.motorola.single_tap=true
ro.vendor.sensors.motorola.udfps=true

# Fingerprint
persist.vendor.fingerprint.type=udfps
persist.vendor.fingerprint.sensor_modules=goodix
persist.vendor.fingerprint.sensor_location=538|2150|90
